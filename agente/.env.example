# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: wacrm | twilio | meta
#   meta todavía no está implementado en este repo.
WHATSAPP_PROVIDER=

# Proveedor de los avisos INTERNOS a vendedores. Opcional.
# Se separa del de arriba porque, con los clientes en wacrm, mandar los
# avisos por ahí metería a cada vendedor como contacto del CRM y cada aviso
# como una conversación en la bandeja del equipo. Si se deja vacío y los
# clientes van por wacrm, los avisos caen a twilio solos.
WHATSAPP_PROVIDER_AVISOS=

# ── wacrm (si WHATSAPP_PROVIDER=wacrm) ────────────────────
# El CRM tiene el número de WhatsApp; Claudia solo pone el cerebro.
# La clave se crea en el CRM: Ajustes > Claves de API. Necesita TRES
# permisos, y no se pueden cambiar despues de crearla:
#   Minimos (sin ellos no arranca):
#     messages:send        enviar la respuesta
#     messages:read        leer los mensajes de una conversacion
#     conversations:read   listar conversaciones y ver si hay agente asignado
#   Opcionales (cada uno habilita una cosa; sin el, lo demas sigue igual):
#     deals:write          la cotizacion aparece en el panel del contacto
#     conversations:write  asignarla sola si nadie la toma
#     contacts:read        leer las etiquetas que ya tiene
#     contacts:write       etiquetarlo como Cotizado
# Se muestra UNA sola vez.
WACRM_URL=https://apps-ambar-wacrm.ejemplo.host
WACRM_API_KEY=
#   Los mensajes entrantes se traen por sondeo, no por webhook: wacrm
#   entrega sus webhooks con un solo intento y 5 s de plazo, y Claudia tarda
#   más que eso. Sondeando, todas las llamadas salen de aquí y no hay que
#   exponer este servidor a internet.
SONDEO_WACRM_ENABLED=true
#   Segundos entre vueltas. Con 5 s son 12 llamadas/min, muy por debajo del
#   límite de 120/min por clave que aplica el CRM.
SONDEO_WACRM_INTERVALO=5

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# Configurar en: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# Configurar en: https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
#   OJO: en modo sandbox NO es tu número de Twilio para SMS ni un número
#   mexicano — es el número FIJO que Twilio te muestra en Console > Messaging
#   > Try it out > Send a WhatsApp message al hacer el "join <código>" desde
#   tu WhatsApp. Normalmente es +14155238886. Poner el número equivocado aquí
#   da el error "63007 — Could not find a Channel with the specified From address".
#
# Plantilla aprobada para avisar a un vendedor cuando su ventana de 24h de
# WhatsApp está cerrada (sin esto, ese aviso se pierde y el cliente queda
# esperando). Es el SID "HX..." de la plantilla — ver PLANTILLA_WHATSAPP.md.
# Si se deja vacío, el sistema funciona igual, solo sin ese respaldo.
TWILIO_CONTENT_SID_AVISO_VENDEDOR=

# ── NetSuite (TBA) — para generar cotizaciones (Estimate) en vivo ────────
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NETSUITE_SUBSIDIARY_ID=

# ── URL pública del servidor (para adjuntar archivos por WhatsApp) ───────
PUBLIC_BASE_URL=

# ── Panel de administración (/admin) ─────────────────────────────────────
# ADMIN_PASSWORD solo se usa UNA VEZ, para crear el usuario "admin" inicial
# si la tabla usuarios_admin está vacía. Después de eso, las contraseñas se
# gestionan desde el propio panel (sección Usuarios) y viven hasheadas en
# la base de datos — cambiar esta variable ya no tiene efecto.
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO  # sube a DEBUG solo para depurar algo puntual (genera mucho ruido)

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Base de NetSuite (catalogo + clientes sincronizados). En Railway el
# filesystem es EFIMERO: apunta esto a un volumen montado o pierdes los
# 3,156 articulos y 8,772 clientes en cada redeploy.
#   Local:   se deja vacio (usa la raiz del proyecto)
#   Railway: NETSUITE_DB_PATH=/data/netsuite_sync.db
NETSUITE_DB_PATH=

# ── Vigilante del tunel de Cloudflare (agent/health_tunel.py) ──
# Detecta si el tunel se cayo o cambio de URL, lo relanza y actualiza
# PUBLIC_BASE_URL. No puede actualizar el webhook de Twilio (el sandbox no
# lo expone por API): eso lo avisa para hacerlo a mano.
# En Railway ponlo en false: alla no hay tunel ni cloudflared.
HEALTH_TUNEL_ENABLED=true
HEALTH_TUNEL_INTERVALO=300
HEALTH_TUNEL_ALERTA_WHATSAPP=

# ── Sync diario de NetSuite (agent/programador.py) ──
# Sustituye al Task Scheduler de Windows cuando corre en Railway (alla no
# hay cron y levantar un segundo servicio duplicaria el costo). Lee la
# marca del ultimo sync desde la base, asi que es idempotente entre
# reinicios: no sincroniza dos veces el mismo dia.
# En LOCAL ponlo en false si ya tienes la tarea de Windows configurada,
# para no sincronizar dos veces.
SYNC_PROGRAMADO_ENABLED=true
SYNC_PROGRAMADO_HORA=7

# Avisos por WhatsApp a vendedores cuando entra un lead. Ponlo en false si
# el canal de salida no es confiable (ej. sandbox de Twilio, que rechaza a
# quien no hizo "join"): la oportunidad en NetSuite y el registro local se
# hacen igual, y Claudia deja de prometerle al cliente una llamada que
# nadie recibio el aviso para hacer.
AVISO_VENDEDOR_ENABLED=true
