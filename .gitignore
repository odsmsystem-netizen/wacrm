# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# keep example files so forkers have a template to copy
!.env.local.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI scratch (version cache, local links). Never source.
supabase/.temp/

# ── El agente (agente/) es Python ───────────────────────────
# Bases de datos locales del agente: memoria de conversaciones y el
# catalogo sincronizado desde NetSuite. Llevan datos de clientes y este
# repositorio es publico — nunca deben versionarse.
*.db
*.db-journal
*.db-wal
*.db-shm
# Cache y entornos de Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
# Salidas del agente: transcripciones que se adjuntan a los avisos y logs
agente/transcripts/
agente/logs/
agente/respaldos/
# Credenciales de NetSuite del agente (OAuth1). El .example si se versiona.
agente/scripts/config.ini

# Binarios descargados (cloudflared pesa 52 MB y ya no se usa:
# el agente habla con el CRM por la red interna, sin tunel).
agente/bin/
